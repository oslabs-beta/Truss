{
  "name": "truss-lint",
  "version": "0.2.0",
  "private": false,
  "description": "Configuration-driven architectural boundary checks",
  "bin": {
    "truss-lint": "dist/bin/truss.js"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "truss:check": "tsx bin/truss.ts check",
    "truss:check:json": "tsx bin/truss.ts check --format json",
    "docker:build": "docker build -t truss-lint .",
    "docker:help": "docker run --rm truss-lint --help",
    "docker:check": "docker run --rm -v \"$PWD:/workspace\" -w /workspace truss-lint check",
    "test:coverage": "node --enable-source-maps --import tsx --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"dist/**\" --test-coverage-exclude=\"node_modules/**\" --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 tests/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1084.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "minimatch": "^10.2.5",
    "typescript": "^5.8.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "tsx": "^4.19.4"
  },
  "keywords": [
    "architecture",
    "dependency-graph",
    "lint",
    "static-analysis",
    "typescript",
    "javascript",
    "cli"
  ],
  "main": "dist/src/index.js"
}
